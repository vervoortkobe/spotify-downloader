NEXT_PUBLIC_API_URL=
FRONTEND_URL=
# Backend security: only requests with this header are accepted (set in Flutter via --dart-define=SPOTTERFY_API_KEY=xxx)
SPOTTERFY_API_KEY=change_me_to_random_64_chars
RATE_LIMIT_DISABLE=0
REFRESH_TOKEN=another_random_secret
FIREBASE_SERVICE_ACCOUNT_JSON=
# warp-svc daemon log level: trace|debug|info|warn|error|off (default warn; 1/true = debug)
WARP_LOG_VERBOSE=warn