<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Spotify-black window background so there is no white flash before the
         Flutter splash paints. Was @android:color/white. -->
    <item android:drawable="@color/spotterfy_launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
