rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Missing user documents are allowed during first-time account creation.
    // Suspended users can still read their own profile to see the reason, but
    // cannot fetch other app data.
    function isNotSuspended() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuspended != true
      );
    }

    // Collection-group queries cannot infer the parent user's id from the
    // query, so grant the admin list an explicit rule for presence browsing.
    match /{path=**}/presence/{presenceId} {
      allow read: if isNotSuspended() && isAdmin();
    }

    // ---- Users ----
    // Any signed-in user can read profiles so Discover can look people up by
    // name. Writes stay owner/admin-only.
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isNotSuspended());
      allow create: if isNotSuspended() && request.auth.uid == userId;
      allow update: if isNotSuspended() &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if isNotSuspended() && isAdmin();

      // Live state is separate from readable profile data: friends and admins
      // can see presence, while only its owner can publish it.
      match /presence/{presenceId} {
        allow read: if isNotSuspended() && (
          request.auth.uid == userId ||
          isAdmin() ||
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(userId))
        );
        allow create, update, delete: if isNotSuspended() &&
          request.auth.uid == userId;
      }

      // Monthly data-usage history, written by the owner's app
      match /dataUsage/{monthId} {
        allow read, write: if isNotSuspended() && request.auth.uid == userId;
      }

      // ---- Friendships ----
      // Each side can read its own list. Acceptance writes both friendship
      // records; the counterpart write is allowed only while an incoming
      // request is pending.
      match /friends/{friendId} {
        allow read: if isNotSuspended() && request.auth.uid == userId;
        allow create: if isNotSuspended() && (
          (request.auth.uid == userId &&
            exists(/databases/$(database)/documents/users/$(userId)/friendRequests/$(friendId)) &&
            get(/databases/$(database)/documents/users/$(userId)/friendRequests/$(friendId)).data.status == 'pending' &&
            get(/databases/$(database)/documents/users/$(userId)/friendRequests/$(friendId)).data.direction == 'incoming') ||
          (request.auth.uid == friendId &&
            exists(/databases/$(database)/documents/users/$(friendId)/friendRequests/$(userId)) &&
            get(/databases/$(database)/documents/users/$(friendId)/friendRequests/$(userId)).data.status == 'pending' &&
            get(/databases/$(database)/documents/users/$(friendId)/friendRequests/$(userId)).data.direction == 'incoming')
        );
        allow update: if isNotSuspended() && request.auth.uid == userId;
        allow delete: if isNotSuspended() && (
          request.auth.uid == userId ||
          (request.auth.uid == friendId &&
            exists(/databases/$(database)/documents/users/$(friendId)/friends/$(userId)))
        );
      }

      // ---- Friend requests ----
      // A request is written to *both* users' subcollections: the recipient's
      // copy is `incoming`, the sender's is `outgoing`. Each side may only
      // touch its own copy, which is what keeps this from being usable to forge
      // a request in someone else's name.
      match /friendRequests/{otherId} {
        allow read: if isNotSuspended() && request.auth.uid == userId;
        allow create: if isNotSuspended() && (
          request.auth.uid == userId ||
          (request.auth.uid == otherId && request.resource.data.direction == 'incoming' &&
            request.resource.data.status == 'pending')
        );
        allow update: if isNotSuspended() && (
          request.auth.uid == userId ||
          (request.auth.uid == otherId &&
            exists(/databases/$(database)/documents/users/$(otherId)/friendRequests/$(userId)) &&
            get(/databases/$(database)/documents/users/$(otherId)/friendRequests/$(userId)).data.status == 'pending')
        );
        allow delete: if isNotSuspended() && (
          request.auth.uid == userId ||
          (request.auth.uid == otherId &&
            exists(/databases/$(database)/documents/users/$(otherId)/friends/$(userId)))
        );
      }

      // ---- Notifications ----
      // The owner reads and clears their own; anyone signed in may create one
      // for a user (that's how a friend request or a message notifies you).
      match /notifications/{notificationId} {
        allow read: if isNotSuspended() && request.auth.uid == userId;
        allow create: if isNotSuspended();
        allow update, delete: if isNotSuspended() && request.auth.uid == userId;
      }
    }

    // ---- Direct messages ----
    // Access is gated on being a listed member, so a chat cannot be read or
    // written by anyone else. The members list is immutable once written, which
    // stops someone being added to a conversation after the fact.
    match /chats/{chatId} {
      allow create: if isNotSuspended()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;
      allow read: if isNotSuspended()
        && request.auth.uid in resource.data.members;
      allow update: if isNotSuspended()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isNotSuspended()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        // Only the sender may write a message, and the sender must be a member.
        allow create: if isNotSuspended()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow update, delete: if false;
      }
    }

    // ---- Top-level playlists: playlists/{id} with creatorUid ----
    // Playlist metadata is readable by any signed-in user so Discover can show
    // and search the community catalogue. Per-track subcollection stays
    // owner-only, and writes are always owner-only.
    match /playlists/{playlistId} {
      allow read: if isNotSuspended();
      allow create: if isNotSuspended()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.keys().hasAll(['creatorUid','name']);
      // Owner, or a user removing *only themselves* from `sharedWith` so they
      // can drop a shared playlist from their own library. The diff check keeps
      // this narrow: the update may touch nothing but `sharedWith`, and the
      // resulting list must be the old one minus exactly this uid, so it can
      // never be used to add or evict other people.
      allow update: if isNotSuspended()
        && (resource.data.creatorUid == request.auth.uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith'])
            && request.resource.data.sharedWith
              == resource.data.sharedWith.removeAll([request.auth.uid])));
      allow delete: if isNotSuspended()
        && resource.data.creatorUid == request.auth.uid;

      match /tracks/{trackId} {
        allow read, write: if isNotSuspended()
          && get(/databases/$(database)/documents/playlists/$(playlistId)).data.creatorUid == request.auth.uid;
      }
    }

    // ---- Discover cache (curated by backend daily job; app also refreshes client-side) ----
    match /discoverCache/{docId} {
      allow read: if request.auth == null || isNotSuspended();
      allow create, update: if isNotSuspended();
      allow delete: if false;
    }

    // ---- Jam sessions ----
    match /jam_sessions/{sessionId} {
      // Signed-in users can browse public jams; queue/playback writes remain
      // limited to members (with a narrow self-join operation below).
      allow read: if isNotSuspended();
      allow create: if isNotSuspended()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update: if isNotSuspended()
        && request.auth.uid in resource.data.participants
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isPlaying', 'currentPositionMs', 'currentTrackIndex'
          ]) ||
          (request.auth.uid == resource.data.createdBy &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'participants', 'isPlaying', 'ended', 'endedAt', 'endedBy'
            ])) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
            request.resource.data.participants == resource.data.participants.removeAll([request.auth.uid])) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']) &&
            request.auth.uid in request.resource.data.participants &&
            request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
            request.resource.data.participants.hasAll(resource.data.participants))
        );
      allow delete: if false;
    }

    // ---- Feedback ----
    // Anyone can submit feedback.
    // Only admins can read, update (mark read/unread), or delete feedback.
    match /feedback/{feedbackId} {
      allow create: if request.auth == null || isNotSuspended() ||
        request.resource.data.type == 'appeal';
      allow read, update, delete: if isNotSuspended() && isAdmin();
    }
  }
}

