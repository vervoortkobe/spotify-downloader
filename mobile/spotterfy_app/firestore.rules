rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the signed-in user an admin? (reads their own user doc)
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ---- Users ----
    match /users/{userId} {
      // Read own profile, or admins read all (for approval / active count)
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Create/update own profile only
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if request.auth != null && isAdmin();

      // ---- Playlists (own + shared) ----
      match /playlists/{playlistId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId ||
           resource.data.sharedWith.hasAny([request.auth.uid]));

        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // ---- Tracks inside playlists ----
        match /tracks/{trackId} {
          allow read: if request.auth != null &&
            (request.auth.uid == userId ||
             get(/databases/$(database)/documents/users/$(userId)/playlists/$(playlistId))
               .data.sharedWith.hasAny([request.auth.uid]));
          allow write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // ---- Shared playlists query (collectionGroup) ----
    match /{userId}/playlists/{playlistId} {
      allow read: if request.auth != null &&
        resource.data.sharedWith.hasAny([request.auth.uid]);
    }

    // ---- Jam sessions ----
    match /jam_sessions/{sessionId} {
      // Authenticated users can read, create and update sessions
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}